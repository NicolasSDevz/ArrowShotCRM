{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/cron/check-meta-token-expiry", "schedule": "0 9 * * *" },
    { "path": "/api/cron/update-metrics", "schedule": "1 0 * * *" },
    { "path": "/api/cron/birthday-notifications", "schedule": "0 11 * * *" }
  ]
}
