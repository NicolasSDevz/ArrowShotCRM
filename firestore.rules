rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return isSignedIn() ? userProfile().role : null;
    }

    // Deactivated users (users/{uid}.active == false) keep a valid Firebase
    // Auth session but lose all app-level access — the frontend signs them
    // out on load, this is the server-side backstop for the gap before that happens.
    function isActive() {
      return isSignedIn() && userProfile().active == true;
    }

    function isInternal() {
      return isActive() && role() in ['admin', 'manager', 'employee'];
    }

    function isAdminOrManager() {
      return isActive() && role() in ['admin', 'manager'];
    }

    function isAdmin() {
      return isActive() && role() == 'admin';
    }

    function isOwnUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // A "client" role user is scoped to exactly one clients/{id} document.
    function isClientUserFor(clientId) {
      return isActive() && role() == 'client' && clientId != null && userProfile().clientId == clientId;
    }

    // Internal staff, or a client-role user scoped to this record's clientId.
    function canReadClientScoped(clientId) {
      return isInternal() || isClientUserFor(clientId);
    }

    function createdBySelf() {
      return request.resource.data.createdBy == request.auth.uid;
    }

    function updatedBySelf() {
      return request.resource.data.updatedBy == request.auth.uid;
    }

    // ---------- public client-approval portal ----------
    // No login for clients yet — a content doc becomes fetchable (by exact id
    // only, never listable/queryable) once approvalToken is set by an
    // internal user, and a matching write is allowed to flip its status.
    // The link itself (content id + token) is the credential, same trust
    // model as e.g. a Stripe payment link — there's no Cloud Functions on
    // this project's plan to validate the token server-side instead.
    // Only actionable while the content is actually awaiting the client
    // ('waiting_client') — so a stale link can't revert a piece that's already
    // approved / scheduled / published. If the team sends it back for another
    // review the status returns to 'waiting_client' and the same link works
    // again.
    function isPublicApprovalUpdate() {
      return resource.data.approvalToken != null
        && resource.data.status == 'waiting_client'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in ['approved', 'production']
        && request.resource.data.updatedBy == 'client-portal';
    }

    function isPublicApproval() {
      return request.resource.data.createdBy == 'client-portal'
        && request.resource.data.updatedBy == 'client-portal'
        && request.resource.data.action in ['approved', 'change_requested']
        && get(/databases/$(database)/documents/contents/$(request.resource.data.contentId)).data.approvalToken != null;
    }

    function isPublicApprovalNotification() {
      return request.resource.data.type in ['content_approved', 'change_requested']
        && request.resource.data.entityType == 'content'
        && get(/databases/$(database)/documents/contents/$(request.resource.data.entityId)).data.approvalToken != null;
    }

    // Shape check for a notification being created. Doesn't (can't, in rules)
    // prove the notification maps to a real triggering action — it just stops
    // any signed-in user from writing arbitrary rows: known type, sane
    // message, unread, server timestamp, no extra fields.
    function isValidNotificationCreate() {
      return request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.type in ['task_assigned', 'mention', 'approval_requested', 'content_approved',
                      'change_requested', 'due_soon', 'briefing_scheduled', 'task_completed',
                      'task_overdue', 'new_client', 'briefing_filled', 'content_review_requested',
                      'content_ready_to_schedule', 'funnel_saved', 'task_reminder',
                      'task_created', 'task_updated', 'client_status_changed', 'client_deleted',
                      'planning_saved', 'content_created', 'content_published', 'content_imported',
                      'lead_created', 'lead_stage_changed', 'lead_converted', 'meeting_created',
                      'report_created', 'team_member_added', 'member_health_updated']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['userId', 'type', 'message', 'actorName', 'entityType', 'entityId', 'read', 'createdAt']);
    }

    // ---------- users ----------
    // Any signed-in user can read the team directory (needed for assignee
    // pickers across the whole app). A user provisions only their OWN doc, and
    // only as an inactive-by-nothing 'employee' — never self-assign a role or
    // status (ensureUserProfile always writes exactly this). Promotion to
    // admin/manager and (de)activation are admin-only, via update. Bootstrapping
    // the very first admin is a one-time manual edit in the Firebase Console.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwnUser(uid)
        && request.resource.data.role == 'employee'
        && request.resource.data.active == true;
      allow update: if isAdmin() || (isOwnUser(uid) && request.resource.data.role == resource.data.role && request.resource.data.active == resource.data.active);
      allow delete: if isAdmin();
    }

    // ---------- clients ----------
    match /clients/{clientId} {
      allow read: if isInternal() || isClientUserFor(clientId);
      allow create: if isInternal() && createdBySelf() && updatedBySelf();
      allow update: if isInternal() && updatedBySelf();
      allow delete: if isAdminOrManager();
    }

    // ---------- tasks ----------
    // Internal-only entity — clients don't see the team's internal task board.
    match /tasks/{taskId} {
      allow read: if isInternal();
      allow create: if isInternal() && createdBySelf() && updatedBySelf();
      allow update: if isInternal() && updatedBySelf();
      allow delete: if isInternal();
    }

    // ---------- contents (Social Media) ----------
    // Clients can read their own content pipeline. Anyone holding a valid
    // approval link can also `get` (never `list`) one specific content doc,
    // and flip its status via isPublicApprovalUpdate() above.
    match /contents/{contentId} {
      allow get: if canReadClientScoped(resource.data.clientId) || resource.data.approvalToken != null;
      allow list: if canReadClientScoped(resource.data.clientId);
      allow create: if isInternal() && createdBySelf() && updatedBySelf();
      allow update: if (isInternal() && updatedBySelf()) || isPublicApprovalUpdate();
      allow delete: if isInternal();
    }

    // ---------- approvals ----------
    match /approvals/{approvalId} {
      allow read: if canReadClientScoped(resource.data.clientId);
      allow create: if (isInternal() && createdBySelf() && updatedBySelf()) || isPublicApproval();
      allow update, delete: if isAdmin();
    }

    // ---------- comments ----------
    match /comments/{commentId} {
      allow read: if canReadClientScoped(resource.data.clientId);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && (isInternal() || isClientUserFor(request.resource.data.clientId));
      allow update: if false; // comments are immutable once posted
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---------- files (metadata only — binaries live in Storage) ----------
    match /files/{fileId} {
      allow read: if canReadClientScoped(resource.data.clientId);
      allow create: if isSignedIn()
        && request.resource.data.uploadedBy == request.auth.uid
        && (isInternal() || isClientUserFor(request.resource.data.clientId));
      allow update: if false;
      allow delete: if isInternal() || isAdmin();
    }

    // ---------- activities (append-only audit log) ----------
    match /activities/{activityId} {
      allow read: if canReadClientScoped(resource.data.clientId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- optimizations (registro de otimizações de campanhas) ----------
    match /optimizations/{optId} {
      allow read: if canReadClientScoped(resource.data.clientId);
      allow create: if isInternal() && createdBySelf() && updatedBySelf();
      allow update: if isInternal() && updatedBySelf();
      allow delete: if isInternal();
    }

    // ---------- settings (config global da plataforma: calendário de
    // otimizações, etc). Um doc por chave, editável por qualquer interno. ----------
    match /settings/{key} {
      allow read: if isInternal();
      allow write: if isInternal();
    }

    // ---------- calendarEvents (custom one-off events) ----------
    match /calendarEvents/{eventId} {
      allow read: if isInternal();
      allow create: if isInternal() && createdBySelf() && updatedBySelf();
      allow update: if isInternal() && updatedBySelf();
      allow delete: if isInternal();
    }

    // ---------- reports (Relatórios semanais/mensais de tráfego) ----------
    match /reports/{reportId} {
      allow read: if isInternal();
      allow create: if isInternal() && createdBySelf() && updatedBySelf();
      allow update: if isInternal() && updatedBySelf();
      allow delete: if isInternal();
    }

    // ---------- leads (Pipeline de novos clientes) ----------
    match /leads/{leadId} {
      allow read: if isInternal();
      allow create: if isInternal() && createdBySelf() && updatedBySelf();
      allow update: if isInternal() && updatedBySelf();
      allow delete: if isInternal();
    }

    // ---------- meetings (Registro de Reuniões) ----------
    match /meetings/{meetingId} {
      allow read: if isInternal();
      allow create: if isInternal() && createdBySelf() && updatedBySelf();
      allow update: if isInternal() && updatedBySelf();
      allow delete: if isInternal();
    }

    // ---------- notifications ----------
    match /notifications/{notificationId} {
      // Admin (Bruno) sees every notification, not just their own — see the
      // in-app notification system's role-visibility rules.
      allow read: if isOwnUser(resource.data.userId) || isAdmin();
      allow create: if isValidNotificationCreate() && (isInternal() || isPublicApprovalNotification());
      allow update: if isOwnUser(resource.data.userId) || isAdmin();
      allow delete: if isOwnUser(resource.data.userId) || isAdmin();
    }

    // ---------- dailyRoutineProgress (widget "Rotina do dia" — quais itens do
    // checklist gerado no frontend já foram marcados hoje, {uid}_{yyyy-MM-dd}).
    // Estritamente pessoal: nunca lido/escrito por outra conta, nem pelo Admin. ----------
    match /dailyRoutineProgress/{progressId} {
      allow read, update, delete: if isOwnUser(resource.data.userId);
      allow create: if isOwnUser(request.resource.data.userId);
    }

    // ---------- teamMembers (Equipe roster: cargo, permissão informativa,
    // rotina — separado de `users`, que controla o acesso real) ----------
    match /teamMembers/{memberId} {
      allow read: if isInternal();
      allow write: if isAdminOrManager();
    }

    // ---------- memberHealth (aba "Informações de Saúde" da Equipe) ----------
    // Ficha médica confidencial, um doc por teamMembers/{id} (mesmo id).
    // Leitura E escrita restritas ao Admin (Bruno) — nunca chega a outra conta.
    match /memberHealth/{memberId} {
      allow read, write: if isAdmin();
    }

    // Subconjunto não-confidencial (tipo sanguíneo, alergias, contato de
    // emergência) espelhado a cada save. Qualquer membro interno pode ler
    // pelo botão "Ver informações de emergência"; só o Admin escreve.
    match /memberEmergency/{memberId} {
      allow read: if isInternal();
      allow write: if isAdmin();
    }

    // ---------- teams / projects ----------
    match /teams/{teamId} {
      allow read: if isInternal();
      allow write: if isAdminOrManager();
    }

    match /projects/{projectId} {
      allow read: if isInternal();
      allow create: if isInternal() && createdBySelf() && updatedBySelf();
      allow update: if isInternal() && updatedBySelf();
      allow delete: if isAdminOrManager();
    }

    // ---------- university (Universidade Arrow Shot) ----------
    // Internal-only training content. Trails/modules are authored by admins
    // and read by any internal staff member; progress docs are written by
    // the learner themself (doc data carries their own uid), admins can read
    // everyone's to build the "progresso por funcionário" view.
    match /trails/{trailId} {
      allow read: if isInternal();
      allow write: if isAdmin();
    }

    match /modules/{moduleId} {
      allow read: if isInternal();
      allow write: if isAdmin();
    }

    match /moduleProgress/{progressId} {
      allow read: if isAdmin() || (isInternal() && isOwnUser(resource.data.userId));
      allow create, update: if isInternal() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /invites/{inviteId} {
      allow read, write: if isAdmin();
    }

    // ---------- future modules ----------
    // When googleAdsCampaigns, metaAdsCampaigns, leads, reports, finance, etc.
    // are introduced, add a `match /{collection}/{docId}` block here following
    // the same shape: read gated by canReadClientScoped(resource.data.clientId),
    // write gated by isInternal() + createdBySelf()/updatedBySelf(). No schema
    // change is needed elsewhere to support this.

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
