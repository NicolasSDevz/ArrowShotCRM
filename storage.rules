rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // NOTE: Storage rules can't read Firestore (firestore.get(...)) on the
    // Spark (free) plan — that cross-service read requires Blaze billing.
    // So Storage access here is "any signed-in team member", not role- or
    // client-scoped like Firestore is. The real access control (who can see
    // which client's data, admin vs employee, etc.) lives in firestore.rules
    // and in the app's own queries — this only gates the raw file bytes.
    // If/when the project moves to Blaze, swap isSignedIn() below for a
    // firestore.get() role+clientId check mirroring firestore.rules.
    function isAllowedType() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('video/.*')
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'application/msword'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        || request.resource.contentType == 'application/vnd.ms-excel'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        || request.resource.contentType == 'text/csv';
    }

    // /clients/{clientId}/{category}/{fileName}
    // category today: social-media | documents. Reserved for future use
    // without any rule change: google-ads | meta-ads | reports.
    match /clients/{clientId}/{category}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && isAllowedType()
        && request.resource.size < 100 * 1024 * 1024; // 100MB cap
      allow delete: if isSignedIn();
    }

    // /leadForms/{formId}/{fileName} — banner/logo do Design do formulário de
    // captura público (ver src/pages/LeadCapturePage.tsx). Leitura pública
    // (sem isso a imagem quebra pra quem só tem o link, sem login) — só a
    // escrita exige sessão interna. Diferente do resto deste arquivo, que é
    // "qualquer logado" porque tudo aqui dentro já era só pra uso interno.
    match /leadForms/{formId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024; // 5MB cap
      allow delete: if isSignedIn();
    }

    // /leadFormUploads/{formId}/{fileName} — arquivos que o LEAD envia numa
    // pergunta do tipo "Arquivo" do formulário público (ex: a logo da empresa),
    // sem login. Só dá pra CRIAR (nunca ler, trocar ou apagar sem login), com
    // limite de 20 MB e só imagem, PDF, formatos de designer (AI/EPS/PSD/CDR)
    // e ZIP. Quem baixa é a equipe, pela ficha do lead.
    match /leadFormUploads/{formId}/{fileName} {
      allow create: if request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType in [
            'application/pdf',
            'application/postscript',
            'application/illustrator',
            'application/vnd.adobe.photoshop',
            'application/x-coreldraw',
            'application/cdr',
            'application/zip',
            'application/x-zip-compressed',
            'application/octet-stream'
          ]);
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
