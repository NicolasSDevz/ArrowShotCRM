rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Alunos da área de membros (claim member) não contam como equipe.
    function isSignedIn() {
      return request.auth != null && request.auth.token.get('member', false) != true;
    }

    // SEGURANÇA (12/11/2026): antes bastava "estar logado" — e qualquer um
    // consegue criar uma conta no Firebase Auth pela API pública. Agora o
    // Storage consulta o perfil no Firestore (projeto no Blaze, regra entre
    // serviços) e só deixa passar equipe interna ativa, como o firestore.rules.
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isInternal() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && profile().active == true
        && profile().role in ['admin', 'manager', 'employee'];
    }

    // Usuário "client" só lê os arquivos do próprio cliente.
    function isClientUserFor(clientId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && profile().active == true
        && profile().role == 'client'
        && profile().clientId == clientId;
    }

    function isAllowedType() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('video/.*')
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'application/msword'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        || request.resource.contentType == 'application/vnd.ms-excel'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        || request.resource.contentType == 'text/csv';
    }

    // /clients/{clientId}/{category}/{fileName}
    // category today: social-media | documents. Reserved for future use
    // without any rule change: google-ads | meta-ads | reports.
    match /clients/{clientId}/{category}/{fileName} {
      allow read: if isInternal() || isClientUserFor(clientId);
      allow write: if isInternal()
        && isAllowedType()
        && request.resource.size < 100 * 1024 * 1024; // 100MB cap
      allow delete: if isInternal();
    }

    // /leadForms/{formId}/{fileName} — banner/logo do Design do formulário de
    // captura público (ver src/pages/LeadCapturePage.tsx). Leitura pública
    // (sem isso a imagem quebra pra quem só tem o link, sem login) — só a
    // escrita exige sessão interna. Diferente do resto deste arquivo, que é
    // "qualquer logado" porque tudo aqui dentro já era só pra uso interno.
    match /leadForms/{formId}/{fileName} {
      allow read: if true;
      allow write: if isInternal()
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024; // 5MB cap
      allow delete: if isInternal();
    }

    // /store/{productId}/{fileName} — imagens da Loja (checkout, capas,
    // banners). Leitura pública: o checkout não tem login.
    match /store/{productId}/{fileName} {
      allow read: if true;
      allow write: if isInternal()
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 8 * 1024 * 1024;
      allow delete: if isInternal();
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
