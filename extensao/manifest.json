{
  "manifest_version": 3,
  "name": "Copiloto de Vendas — Arrow Shot",
  "version": "1.0.2",
  "description": "Assistente de IA ao vivo durante chamadas no Google Meet, integrado ao CRM Arrow Shot (painel lateral do Chrome).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Copiloto de Vendas"
  },
  "permissions": ["sidePanel", "tabCapture", "offscreen", "storage", "tabs"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://arrowshotcrm.vercel.app/*"
  ]
}
