# Firebase — copie este arquivo para .env.local e preencha com os valores
# do seu projeto (Firebase Console > Configurações do projeto > Geral >
# "Seus apps" > SDK setup and configuration > Config).
#
# Nenhum destes valores é secreto: eles identificam o projeto Firebase no
# cliente, e o acesso real aos dados é controlado pelas Security Rules
# (firestore.rules / storage.rules), não por essas chaves.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Calendar — OAuth Client ID (Web application) from Google Cloud
# Console > APIs & Services > Credentials. Public value, safe on the client
# (this is a standard OAuth "public client" for browser apps — no secret
# involved). Used for the "Conectar Google Calendar" feature.
VITE_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Meta Ads / Google Ads — usadas SÓ pelas Vercel Functions em /api (Node,
# roda no servidor). Sem prefixo VITE_ de propósito: qualquer variável
# VITE_* é embutida no bundle JavaScript e fica visível a qualquer visitante
# do site — nunca coloque um App Secret, Access Token ou Refresh Token
# atrás de VITE_. O frontend nunca lê estes valores diretamente; ele chama
# /api/meta/... e /api/google/... (ver src/services/metaApi.js), e é a
# função serverless que usa process.env.META_ACCESS_TOKEN etc.
# Configuração em produção: painel do Vercel > Settings > Environment
# Variables (não vercel.json).

META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_BUSINESS_ID=

# ---------------------------------------------------------------------------
# Tokens de acesso Meta Ads POR CLIENTE — necessário quando a conta de
# anúncios do cliente vive no Business Manager DELE (fora do alcance do
# usuário "automacaoads" da Arrow Shot, que só acessa o BM da agência). Cada
# cliente pode ter seu próprio token, salvo (criptografado) via
# POST /api/meta/token e usado automaticamente pelas rotas /api/meta/* na
# ausência ou defeito do token global acima. Ver api/_lib/metaTokenStore.js
# e api/_lib/tokenCrypto.js.

# JSON da service account do Firebase (Console > Configurações do projeto >
# Contas de serviço > Gerar nova chave privada), em base64 numa linha só:
#   base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_KEY=

# Chave de 32 bytes em base64 para cifrar (AES-256-GCM) os tokens por
# cliente antes de gravar no Firestore. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar essa chave invalida todos os tokens de cliente já salvos.
META_TOKEN_ENCRYPTION_KEY=

# Segredo do Vercel Cron (Settings > Environment Variables). Quando
# configurado, /api/cron/check-meta-token-expiry só aceita requisições com
# `Authorization: Bearer <CRON_SECRET>` — que é o header que o Vercel Cron
# manda automaticamente. Ver vercel.json > crons.
CRON_SECRET=

# META_APP_ID e META_APP_SECRET (acima) também são usados por
# /api/meta/exchange-token para trocar um token curto do Explorador da API
# por um de longa duração (~60 dias).

GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
